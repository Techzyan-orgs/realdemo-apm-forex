DATABASE_URL="file:./dev.db"
STORAGE_DIR="./storage"
# random 32+ bytes; signs order access tokens (openssl rand -hex 32)
ORDER_TOKEN_SECRET="change-me-to-a-random-32-byte-hex-string-000000"
# Owner login for /admin (demo: email + plain password from env).
# ADMIN_AUTH_ENABLED="false" turns login off for local development only - never deploy publicly like that.
ADMIN_AUTH_ENABLED="true"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# optional: signs the session cookie; derived from ADMIN_PASSWORD + ORDER_TOKEN_SECRET when empty
ADMIN_SESSION_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"
NEXT_PUBLIC_SUPPORT_PHONE="+91 XXXXX XXXXX (placeholder)"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com (placeholder)"
NEXT_PUBLIC_STORE_HOURS="Mon-Sat 10:00-19:00 (placeholder)"
NEXT_PUBLIC_GRIEVANCE_OFFICER="Grievance Officer (placeholder)"
NEXT_PUBLIC_RBI_LICENCE_TYPE="FFMC"
NEXT_PUBLIC_RBI_LICENCE_NO="FFMC-XXXX-XXXX (placeholder)"
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
CRON_SECRET=""
RATES_FEED_URL="https://open.er-api.com/v6/latest/INR"
